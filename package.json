{
  "name": "arsenal-agent-skills",
  "version": "2.2.0",
  "description": "Portable workflow skills and optional continuous Arsenal routing for OMP and Pi.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mirkobozzetto/arsenal.git"
  },
  "keywords": [
    "pi-package",
    "agent-skills",
    "coding-agent",
    "codex",
    "claude-code"
  ],
  "files": [
    "plugins/arsenal/skills",
    "plugins/brief/skills",
    "plugins/propose/skills",
    "plugins/ship/skills",
    "plugins/issue/skills",
    "plugins/next/skills",
    "plugins/trace/skills",
    "plugins/websearch/skills",
    "plugins/ship/runtime/pi-extension.ts",
    "assets/social-preview.png",
    "!**/__pycache__/**",
    "!**/*.pyc"
  ],
  "pi": {
    "extensions": [
      "./plugins/ship/runtime/pi-extension.ts"
    ],
    "skills": [
      "./plugins/*/skills/*/SKILL.md"
    ],
    "image": "https://raw.githubusercontent.com/mirkobozzetto/arsenal/main/assets/social-preview.png"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  }
}
